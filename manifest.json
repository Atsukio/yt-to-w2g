{
  "manifest_version": 3,
  "name": "W2G Quick Add",
  "version": "1.0.0",
  "description": "Hover a YouTube video and add it to your Watch2Gether room playlist in one click.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.w2g.tv/*", "https://w2g.tv/*", "https://www.youtube.com/oembed*"],
  "background": { "service_worker": "background/service-worker.js", "type": "module" },
  "action": { "default_popup": "popup/popup.html" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://youtu.be/*"],
      "js": ["content/adapters/youtube.js", "content/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://w2g.tv/*"],
      "js": ["content/w2g-page.js"],
      "run_at": "document_idle"
    }
  ]
}
